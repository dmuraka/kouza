###########################################################
##### Spatiotemporal modeling using sdmTMB package ########
###########################################################

#install.packages(c("dplyr","ggplot2","sdmTMB","sf","sp"))
library(dplyr)
library(ggplot2)
library(sdmTMB)
library(sf)
library(sp)

####### Read pcod data
pcod   <-data.frame(pcod[pcod$year>=2009, c("year","X","Y","depth","density","present")])
pcod[1:10,]

####### Plot presence/absence of Pacific Cod
pcod_s <- st_as_sf(pcod,coords=c("X","Y"))
ggplot(pcod_s) + 
  geom_sf(aes(color = present)) +
  facet_wrap(~year) + 
  theme_minimal() +
  scale_color_gradient(low = "lightgrey", high = "red")

####### Generate spatial mesh
mesh <- make_mesh(pcod, xy_cols = c("X", "Y"), cutoff = 1)
plot(mesh,pch=1)

####### Spatial logistic regression
fit0 <- sdmTMB(
  present ~ as.factor( year ),
  data = pcod,
  mesh = mesh,
  family = binomial(link = "logit"),
  spatial = "on",
  reml=FALSE)

plot( pcod$depth, predict(fit0)$est)

####### Spatial logistic regression（considering non-linear effects of depth）
fit1<- sdmTMB(
  present ~ s(depth) + as.factor( year ),
  data = pcod,
  mesh = mesh,
  family = binomial(link = "logit"),
  spatial = "on",
  reml=FALSE)

####### Model comparison
AIC(fit0)
AIC(fit1)

####### Parameter estimation result
fit1
tidy(fit1, conf.int = TRUE)
tidy(fit1, effects = "ran_pars", conf.int = TRUE)

####### Data processing for spatial prediction
qcs_grid2<-NULL
for(year in unique(pcod$year)){
  qcs_grid_sub<-data.frame(year,qcs_grid[,1:3])
  qcs_grid2   <-rbind(qcs_grid2,qcs_grid_sub)
}

####### Spatial prediction
qcs_grid2[1:2,]
p   <- predict(fit1, newdata = qcs_grid2, type="response")
p[1:3,]
p_s <- st_as_sf(p,coords=c("X","Y"))
ggplot(p_s) + 
  geom_sf(aes(color = est),pch=15,cex=0.5) +
  facet_wrap(~year) + 
  theme_minimal() +
  scale_color_gradient(low = "lightgrey", high = "red")

####### Spatio-temporal logistic regression
fit2<- sdmTMB(
  present ~ s(depth) + as.factor( year ),
  data = pcod,
  mesh = mesh,
  family = binomial(link = "logit"),
  spatial = "on",
  time = "year",
  spatiotemporal = "ar1",
  reml=FALSE)

####### Parameter estimation
fit2
tidy(fit2, conf.int = TRUE)
tidy(fit2, effects = "ran_pars", conf.int = TRUE) # 同上
AIC(fit1)
AIC(fit2)

####### Spatiotemporal prediction
p2   <- predict(fit2, newdata = qcs_grid2, type="response")
p2[1:3,]
p2_s <- st_as_sf(p2,coords=c("X","Y"))
ggplot(p2_s) + 
  geom_sf(aes(color = est),pch=15,cex=0.5) +
  facet_wrap(~year) + 
  theme_minimal() +
  scale_color_gradient(low = "lightgrey", high = "red")

####### Uncertainty evaliation
p2_sim     <- predict(fit2, newdata = qcs_grid2, type="response", nsim=500)
p2_s$est_sd<- apply(p2_sim, 1, sd)
ggplot(p2_s) + 
  geom_sf(aes(color = est_sd),pch=15,cex=0.5) +
  facet_wrap(~year) + 
  theme_minimal() +
  scale_color_gradient(low = "lightgrey", high = "red")

#####################################################################
##### Spatiotemmporal modeling considering physical barrier #########
#####################################################################

#remotes::install_github("pbs-assess/sdmTMBextra", dependencies = TRUE)
#remotes::install_github("ropensci/rnaturalearthhires")
 
library(rnaturalearthhires)
library(rnaturalearth)
library(sdmTMB)
library(sdmTMBextra)
library(sf)
library(ggplot2)

####### Read data
data(pcod)                                                 # Pacific cod data
pcod      <- data.frame(pcod[pcod$year>=2009,])            # Data after 2009 is used
canada_map<- ne_countries(scale = "large",country="canada")# Land area data in Canada
pcod_map  <- st_crop(canada_map, c(xmin = -132, ymin = 50, xmax = -127, ymax = 53)) # Land area in the study area
pcod_s    <- st_as_sf(pcod,coords=c("lon","lat"), crs=st_crs(pcod_map))

ggplot(pcod_map) + geom_sf() +
  theme_minimal() + geom_sf(data = pcod_s, size = 1)

####### Spatial mesh considering physical barrier
mesh      <- make_mesh(pcod, xy_cols = c("lon", "lat"), cutoff=0.005)
bmesh     <- add_barrier_mesh(spde_obj = mesh, 
                              barrier_sf = pcod_map, 
                              range_fraction = 0.001)
mesh_water <- bmesh$mesh_sf[bmesh$normal_triangles , ]
mesh_land  <- bmesh$mesh_sf[bmesh$barrier_triangles, ]
ggplot(pcod_map) + geom_sf() +
  geom_sf(data = mesh_water, size = 0.8, colour = "blue") +
  geom_sf(data = mesh_land, size = 2, colour = "red")

####### Spatial logistic regression
fit <- sdmTMB(present ~ 1,data = pcod,mesh = bmesh,
              family = binomial(link = "logit"),spatial = "on")

####### Data processing for spatial prediction
qcs_grid$X1000<- qcs_grid$X*1000                                        # Change unit of spatial coordinates: km to m
qcs_grid$Y1000<- qcs_grid$Y*1000                                        # Change unit of spatial coordinates: km to m
qcs_grid_s    <- st_as_sf(qcs_grid, coords=c("X1000","Y1000"),crs=3156) # Transform UTM
qcs_grid_s    <- st_transform(qcs_grid_s, 4326)                         # to WGS84
qcs_grid_coords<-st_coordinates(qcs_grid_s)                             # Spatial coordinates of WGS84
qcs_grid$lon  <-qcs_grid_coords[,1]             # Longitude
qcs_grid$lat  <-qcs_grid_coords[,2]             # Latitude

####### Spatial prediction
p   <- predict(fit, newdata = qcs_grid, type="response")
p_s <- st_as_sf(p,coords=c("lon","lat"))
ggplot(p_s) + 
  geom_sf(aes(color = est),pch=15) +
  theme_minimal() +
  scale_color_gradient(low = "lightgrey", high = "red")
